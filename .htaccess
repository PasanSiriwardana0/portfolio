# Protect visits.json file from direct access
<Files "visits.json">
    Order Allow,Deny
    Deny from all
</Files>

# Allow view_visits.php
<Files "view_visits.php">
    Order Allow,Deny
    Allow from all
</Files>

# Allow index.php
<Files "index.php">
    Order Allow,Deny
    Allow from all
</Files>

# Prevent directory listing
Options -Indexes

# Default page
DirectoryIndex index.php

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>